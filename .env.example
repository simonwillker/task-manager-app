# compose.yaml で本番公開するときの設定。.env にコピーして書き換える（.env はコミットしない）

# 公開するドメイン。DNS の A / AAAA レコードをこのサーバーに向けておくと、Caddy が HTTPS 証明書を自動で取得する
DOMAIN=tasks.example.com

# メール送信（確認メール・パスワード再設定メール）
# Resend (https://resend.com) で API キーを発行し、MAIL_FROM のドメインを認証しておく
MAIL_TRANSPORT=resend
MAIL_FROM=Task Manager <no-reply@tasks.example.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 認証系 API への IP アドレスごとのリクエスト上限（15 分あたり）
# AUTH_RATE_LIMIT_PER_IP=60
