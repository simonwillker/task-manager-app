# compose.yaml で本番公開するときの設定。.env にコピーして書き換える（.env はコミットしない）

# 公開するドメイン。DNS の A / AAAA レコードをこのサーバーに向けておくと、Caddy が HTTPS 証明書を自動で取得する
DOMAIN=tasks.example.com

# メール送信（確認メール・パスワード再設定メール）
# Resend (https://resend.com) で API キーを発行し、MAIL_FROM のドメインを認証しておく
MAIL_TRANSPORT=resend
MAIL_FROM=Task Manager <no-reply@tasks.example.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 認証系 API への IP アドレスごとのリクエスト上限（15 分あたり）
# AUTH_RATE_LIMIT_PER_IP=60

# --- タスクの削除 ---
# タスクを削除できるのは管理者だけ。ここにメールアドレスをカンマ区切りで並べる。
# 未設定の場合は、最初に登録したユーザーだけが管理者になる。
# ADMIN_EMAILS=admin@example.com,boss@example.com
# "@example.com" のように @ で始めると、そのドメイン全員が管理者になる
# ADMIN_EMAILS=@example.com

# 削除するときに入力させる合言葉（既定値は 123456）。
# アカウントのパスワードとは別物で、管理者全員で共有する「誤操作止め」。
# 本番では推測されにくい文字列に変えること。
# DELETE_PASSWORD=123456
